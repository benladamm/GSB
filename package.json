{
  "name": "gsb-pharmalink",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme B2B e-commerce pharmaceutique GSB PharmaLink - BTS SIO SLAM (Architecture 3-Tiers : Next.js + Express + MySQL)",
  "scripts": {
    "dev": "concurrently -k -n \"EXPRESS,NEXT\" -c \"cyan,magenta\" \"tsx watch server/src/server.ts\" \"next dev\"",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "next dev",
    "server": "tsx server/src/server.ts",
    "client": "next dev",
    "build": "next build",
    "start": "concurrently -k -n \"EXPRESS,NEXT\" -c \"cyan,magenta\" \"tsx server/src/server.ts\" \"next start\"",
    "lint": "next lint",
    "db:init": "node scripts/init-db.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.11.3",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
