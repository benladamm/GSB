72A; font-weight:bold;&quot;&gt;Portail E-Commerce GSB&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td style=&quot;color:#64748B;&quot;&gt;&lt;b&gt;Formation :&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#0F172A;&quot;&gt;BTS SIO 2e annee (SLAM)&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td style=&quot;color:#64748B;&quot;&gt;&lt;b&gt;Version :&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#0F172A;&quot;&gt;1.1 — Conception MCD (Sans lien direct Pro-Fournisseur)&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td style=&quot;color:#64748B;&quot;&gt;&lt;b&gt;Methode :&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#0F172A;&quot;&gt;MERISE Standard&lt;/td&gt;&lt;/tr&gt;&#10;  &lt;/table&gt;&#10;  &lt;div style=&quot;font-size:11px; font-weight:bold; color:#0F172A; border-top:1px solid #CBD5E1; padding-top:4px; margin-bottom:3px;&quot;&gt;&#10;    RAPPEL DES CARDINALITES :&#10;  &lt;/div&gt;&#10;  &lt;div style=&quot;font-size:10px; line-height:1.45; color:#334155;&quot;&gt;&#10;    • &lt;b&gt;(0,1)&lt;/b&gt; : Au plus un (relation optionnelle)&lt;br/&gt;&#10;    • &lt;b&gt;(1,1)&lt;/b&gt; : Un et un seul (relation obligatoire)&lt;br/&gt;&#10;    • &lt;b&gt;(0,n)&lt;/b&gt; : Zero a plusieurs (multiple optionnel)&lt;br/&gt;&#10;    • &lt;b&gt;(1,n)&lt;/b&gt; : Au moins un (multiple obligatoire)&#10;  &lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1580" y="950" width="420" height="280" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>