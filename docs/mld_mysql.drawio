lt;/td&gt;&lt;/tr&gt;&#10;  &lt;/table&gt;&#10;  &lt;div style=&quot;font-size:11px; font-weight:bold; color:#0F172A; border-top:1px solid #CBD5E1; padding-top:4px; margin-bottom:3px;&quot;&gt;&#10;    CONVENTIONS :&#10;  &lt;/div&gt;&#10;  &lt;div style=&quot;font-size:10px; line-height:1.45; color:#334155;&quot;&gt;&#10;    • &lt;u&gt;&lt;b&gt;Souligné&lt;/b&gt;&lt;/u&gt; : Clé primaire (PK)&lt;br/&gt;&#10;    • &lt;b&gt;#Préfixé&lt;/b&gt; : Clé étrangère (FK)&lt;br/&gt;&#10;    • Flèche : Relation référentielle FK → PK&lt;br/&gt;&#10;    • Approvisionnement multi-fournisseurs par panier/commande&#10;  &lt;/div&gt;&#10;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1600" y="950" width="420" height="270" as="geometry" /></mxCell><mxCell id="fk_user_role" value="id_role → id_role" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=#94A3B8;" edge="1" parent="1" source="tbl_utilisateurs" target="tbl_roles"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_med_fournisseur" value="id_fournisseur" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=#94A3B8;" edge="1" parent="1" source="tbl_medicaments" target="tbl_fournisseurs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_med_categorie" value="id_categorie" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=#94A3B8;" edge="1" parent="1" source="tbl_me